HIPPOCAMPUS_DB=./data/hippocampus.db
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
HIPPOCAMPUS_LLM_MODEL=local-memory-extractor
HIPPOCAMPUS_TIMEZONE=UTC

# Phase 5 integrity storage. Keep these outside source control.
HIPPOCAMPUS_SECURITY_DIR=./data/.hippocampus-security
HIPPOCAMPUS_BACKUP_DIR=./data/backups
# Optional: use a separately protected location for rollback detection.
# HIPPOCAMPUS_ANCHOR_PATH=Z:/protected/hippocampus/latest-checkpoint.json
# Optional. When set before the first start, private signing keys are encrypted.
# HIPPOCAMPUS_KEY_PASSPHRASE=replace-with-a-local-secret

# Optional: used by POST /learn/openwebui/chat/{chat_id}
OPENWEBUI_DB=../data/webui.db

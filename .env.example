# Ver0.2 only: explicit new database and server-side credential registry.
# Paths below are examples; keep actual data and credentials out of source control.
HIPPOCAMPUS_V02_DB=./data/hippocampus-v02.db
HIPPOCAMPUS_V02_AUTH_FILE=./data/v02-server-auth.json

# Optional encryption of newly generated signing keys.
# HIPPOCAMPUS_V02_KEY_PASSPHRASE=local-secret-from-your-environment

# Experimental changes to behavior are independently disabled by default.
HIPPOCAMPUS_V02_FEEDBACK_EFFECTS=0
HIPPOCAMPUS_V02_GRAPH_LEARNING=0
HIPPOCAMPUS_V02_FEEDBACK_TTL=1800

# Private frontend/nightly process only (contains plaintext bearer credentials).
# HIPPOCAMPUS_V02_CLIENT_FILE=./data/v02-client-auth.json
# HIPPOCAMPUS_SERVICE_DIR=/absolute/path/to/hippocampus
# HIPPOCAMPUS_HOOK_ENABLED=1
# HIPPOCAMPUS_AUTO_CAPTURE_ENABLED=1
# HIPPOCAMPUS_LOGICAL_ACTOR_ID=assistant:primary

# No old API fallback, activation aliases, model calls or fixed context cap.
